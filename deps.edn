{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; kotoba-lang/psa is this vertical's domain capability library
        ;; (rate cards, staffing against capacity, margin, utilization,
        ;; invoice drafting). Referenced by workspace-sibling path per the
        ;; fleet's capability-library-wrapping convention (same as
        ;; cloud-itonami-isco-4313 wraps kotoba-lang/labor). It is
        ;; dependency-free, so it is also consumable as a plain git dep
        ;; once a fork wants one.
        io.github.kotoba-lang/psa
        {:git/url "https://github.com/kotoba-lang/psa.git"
         :git/sha "f9c96f337abd45ee025d58d6549d985c32fd1dfa"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + seq-keyed event streams) — ADR-2607141600.
        io.github.kotoba-lang/langchain-store
        {:git/url "https://github.com/kotoba-lang/langchain-store.git"
         :git/sha "b986669f72276568c97e1fa5b331a5ff3017bf69"}
        ;; CACAO verification for the edge. Depended on, never
        ;; reimplemented (ADR-2607268000).
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         :git/sha "b395935018d97ee281c9b4564f855c8242b438e7"}
        ;; the itonami actor pattern's governor layer, written once.
        io.github.kotoba-lang/governor
        {:git/url "https://github.com/kotoba-lang/governor.git"
         :git/sha "90a2944e617e58b9c90314b7e84b003ec3ea0c1f"}
        io.github.kotoba-lang/taxlaw
        {:git/url "https://github.com/kotoba-lang/taxlaw.git"
         :git/sha "d2663b54aad645244e61ae548054943b1229c1fc"}}
 :aliases
 {;; clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; The :cljs branch of the edge ns. shadow-cljs.edn declares
  ;; :deps {:aliases [:cljs]}, so shadow itself has to be on THIS
  ;; classpath — `npm install` alone puts the launcher in node_modules
  ;; and the build then fails to locate shadow.cljs.devtools.cli.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
